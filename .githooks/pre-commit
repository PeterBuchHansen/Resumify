#!/usr/bin/env bash
# Refresh models_vault/*.enc when plaintext is newer, missing ciphertext, or ciphertext is orphaned.
# Requires OpenSSL. Install once: bash scripts/install-git-hooks.sh
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "${ROOT:-}" ]] || exit 0
cd "$ROOT"

[[ -f .passphrase ]] || exit 0
[[ -f scripts/vault-crypto.sh ]] || exit 0
[[ -d models_vault ]] || exit 0

vault_needs_encrypt() {
  local f b enc
  shopt -s nullglob
  for f in models_vault/*; do
    [[ -f "$f" ]] || continue
    b="$(basename "$f")"
    [[ "$b" == *.enc ]] && continue
    enc="models_vault/${b}.enc"
    if [[ ! -f "$enc" || "$f" -nt "$enc" ]]; then
      return 0
    fi
  done
  for enc in models_vault/*.enc; do
    [[ -f "$enc" ]] || continue
    b="$(basename "$enc" .enc)"
    [[ -f "models_vault/$b" ]] || return 0
  done
  return 1
}

if ! vault_needs_encrypt; then
  exit 0
fi

bash scripts/vault-crypto.sh encrypt-from models_vault -q
git add -A models_vault/
